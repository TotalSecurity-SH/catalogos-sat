# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública (anon / publishable). Solo permite leer el catálogo gracias a RLS.
SUPABASE_ANON_KEY=tu-clave-publica

# Solo para cargar los datos una vez (scripts/cargar_datos.sh). No se usa en Vercel.
# Supabase → Connect → Session pooler
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
